{
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "higgsfield": {
      "source": {
        "source": "github",
        "repo": "higgsfield-ai/skills"
      }
    }
  },
  "enabledPlugins": {
    "watch@claude-video": true,
    "higgsfield@higgsfield": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f scripts/check-inline-js.js ] && node scripts/check-inline-js.js >&2 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
