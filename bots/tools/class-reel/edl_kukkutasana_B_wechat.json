 "phrases": [
  {
   "text": "Whoever says this\nis not difficult"
  },
  {
   "text": "is either lying...\nor a great yogi."
  },
  {
   "text": "It takes three things."
  },
  {
   "text": "One.\nYears of practice."
  },
  {
   "text": "Two.\nProper technique."
  },
  {
   "text": "Tuck your thighs\nto your chest"
  },
  {
   "text": "when you jump."
  },
  {
   "text": "Hold your core\nand push the floor away."
  },
  {
   "text": "Back round."
  },
  {
   "text": "Control your breath."
  },
  {
   "text": "Keep the body stable."
  },
  {
   "text": "And three."
  },
  {
   "text": "The technique\nmust fit your body."
  },
  {
   "text": "Everybody is missing\na different piece."
  },
  {
   "text": "Find what your body\nis missing, and fix it."
  },
  {
   "text": "Then one day someone\nsees you and says,"
  },
  {
   "text": "“You make it look\nso easy.”"
  },
  {
   "text": "You just smile."
  },
  {
   "text": "You know what it took."
  },
  {
   "text": "Come practice\nat AYBKK.",
   "cy": 0.68
  }
 ],
